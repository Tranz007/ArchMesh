{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    "noEmit": false
  },
  "include": [
    "src/cli.ts",
    "src/cli-options.ts",
    "src/build-graph.ts",
    "src/output.ts",
    "src/watch.ts",
    "src/types.ts",
    "src/scanner/**/*.ts",
    "src/health/**/*.ts",
    "src/changes/**/*.ts",
    "src/drift/**/*.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
