{
  "name": "archmesh",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first visual architecture explorer for modern software projects.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "scan": "tsx src/scanner/cli.ts",
