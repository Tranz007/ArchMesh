{
  "name": "archmesh",
  "version": "0.1.0",
  "description": "Local-first visual architecture explorer for modern software projects.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archmesh": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "index.html",
    "vite.config.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:node": "tsc -p tsconfig.cli.json",
    "build:viewer": "vite build",
    "build": "npm run clean && npm run build:node && npm run build:viewer",
    "preview": "vite preview",
    "scan": "tsx src/scanner/cli.ts",
    "atlas": "tsx src/cli.ts",
    "pack:check": "npm pack --dry-run",
    "ux:install": "npx skills add Tranz007/ux-skills --all",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sigma": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
